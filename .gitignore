# Source allowlist: local runtime/account/history artifacts are never Git defaults.
/*
!/.gitignore
!/.dockerignore
!/LICENSE
!/NOTICE
!/Cargo.toml
!/Cargo.lock
!/build.rs
!/README.md
!/README.zh-CN.md
!/DESIGN.md
!/src/
!/crates/
!/tests/
!/scripts/
!/docs/
!/operator-desktop/

# Private runtime data and historical experiments, including real-account reports.
/.runtime/
/experiments/
/target/
/research/
/examples/
/VALIDATION.md
**/VALIDATION.md
**/.state/
**/.cache/
**/target/
**/reports/
**/logs/
**/node_modules/
**/__pycache__/
**/.venv/

# Imported credentials and operator-only login inputs.
.env
.env.*
**/auth.json
**/credentials.json
**/cookies.txt
**/cookies.json
**/*cookie*.txt
**/*cookie*.json
**/*credential*.json
**/*password*.json
**/*password*.txt
**/*session*.json
**/token.json
**/tokens.json
**/*-token.json
**/*_token.json
**/*oauth*token*
**/*bduss*
**/qrcode.png
**/qrcode.json
*.pem
*.key
*.p12
*.pfx

# Engine/signing binaries, native libraries, installers and downloaded model weights.
*.node
*.so
*.so.*
*.dylib
*.dll
*.exe
*.a
*.o
*.deb
*.rpm
*.gguf
*.safetensors
*.onnx

# Unreviewed upstream reference vectors; local copies remain available for audit.
/crates/runtime-media/vendor/rvoip-amr/src/codecs/amr/testdata/

# Desktop build output stays local; only source/config/lock is public.
/operator-desktop/gen/

# Optional third-party artwork remains local until redistribution is established.
/operator-desktop/frontend/brands/bilibili.ico
/operator-desktop/frontend/brands/qq.png
/operator-desktop/frontend/brands/tieba.jpg
/operator-desktop/frontend/brands/weixin.png
/operator-desktop/frontend/brands/antigravity.svg
/operator-desktop/frontend/brands/github.svg
/operator-desktop/frontend/brands/codex.png
/operator-desktop/frontend/brands/pixiv.png
/operator-desktop/frontend/brands/reddit.png
/operator-desktop/frontend/brands/discord.svg
/scripts/import-qq.sh
/scripts/validate-x-live.py
/scripts/validate-x-expansion-live.py
