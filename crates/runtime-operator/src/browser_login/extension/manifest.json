{
  "manifest_version": 3,
  "name": "Glimlink Session Bridge",
  "version": "0.1.0",
  "description": "Connect a selected signed-in website account to your local Glimlink operator.",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "128": "icon-128.png" },
  "key": "",
  "permissions": [
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://www.pixiv.net/*",
    "https://pixiv.net/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "connect.html",
        "probe.svg"
      ],
      "matches": [
        "http://127.0.0.1/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*"
  }
}
