{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glimlink Operator",
  "version": "0.1.0-alpha.2",
  "identifier": "io.glimlink.operator",
  "mainBinaryName": "agent-operator-desktop",
  "build": { "frontendDist": "frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "create": false,
      "title": "Glimlink Operator",
      "width": 1180,
      "height": 820,
      "minWidth": 780,
      "minHeight": 620,
      "resizable": true,
      "backgroundColor": "#f5f3f8",
      "devtools": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active": false, "icon": [] }
}
